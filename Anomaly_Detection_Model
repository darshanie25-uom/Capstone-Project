      "source": [
        "# Anomaly Detection\n",
        "\n",
        "ANOMALY_THRESHOLD = 1\n",
        "\n",
        "anomaly_list = []\n",
        "\n",
        "for site in forecasts.keys():\n",
        "\n",
        "    forecast = forecasts[site][['ds', 'yhat']]\n",
        "\n",
        "    actual = val_df[\n",
        "        val_df['site_name'] == site\n",
        "    ][['ds', 'y']]\n",
        "\n",
        "    # Merge\n",
        "    merged = pd.merge(\n",
        "        actual,\n",
        "        forecast,\n",
        "        on='ds',\n",
        "        how='left'\n",
        "    )\n",
        "\n",
        "    # Rename\n",
        "    merged['ActualTraffic'] = merged['y']\n",
        "\n",
        "    merged['PredictedTraffic'] = merged['yhat']\n",
        "\n",
        "    # NULL Anomalies\n",
        "    merged['is_null_anomaly'] = (\n",
        "        merged['ActualTraffic'].isnull()\n",
        "    )\n",
        "\n",
        "    # Remove Zero Predictions\n",
        "    merged = merged[\n",
        "        merged['PredictedTraffic'] != 0\n",
        "    ]\n",
        "\n",
        "    # Deviation\n",
        "    merged['deviation'] = (\n",
        "        abs(\n",
        "            merged['ActualTraffic']\n",
        "            -\n",
        "            merged['PredictedTraffic']\n",
        "        )\n",
        "        /\n",
        "        merged['PredictedTraffic']\n",
        "    )\n",
        "\n",
        "    # Deviation Anomaly\n",
        "    merged['is_deviation_anomaly'] = (\n",
        "        merged['deviation'] > ANOMALY_THRESHOLD\n",
        "    )\n",
        "\n",
        "    # Final Anomalies\n",
        "    anomalies = merged[\n",
        "        (\n",
        "            merged['is_null_anomaly']\n",
        "        )\n",
        "        |\n",
        "        (\n",
        "            merged['is_deviation_anomaly']\n",
        "        )\n",
        "    ].copy()\n",
        "\n",
        "    anomalies['site_name'] = site\n",
        "\n",
        "    anomaly_list.append(anomalies)\n",
        "\n",
        "# Combine Anomalies\n",
        "anomaly_df = pd.concat(anomaly_list)\n",
        "\n",
        "# Select Output\n",
        "anomaly_df = anomaly_df[\n",
        "    [\n",
        "        'ds',\n",
        "        'site_name',\n",
        "        'ActualTraffic',\n",
        "        'PredictedTraffic',\n",
        "        'deviation',\n",
        "        'is_null_anomaly',\n",
        "        'is_deviation_anomaly'\n",
        "    ]\n",
        "]\n",
        "\n",
        "anomaly_df = anomaly_df.rename(columns={\n",
        "    'ds': 'datetime'\n",
        "})\n",
        "\n",
        "# Display Anomalies\n",
        "print(\"\\n===== ANOMALY REPORT =====\")\n",
        "print(anomaly_df)\n",
        "\n",
        "# Save Report\n",
        "anomaly_df.to_csv(\n",
        "    \"prophet_anomaly_report.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\nAnomaly report saved.\")"
