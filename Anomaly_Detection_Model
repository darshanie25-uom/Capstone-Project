        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from prophet import Prophet\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "# Create Date Time\n",
        "df['date'] = pd.to_datetime(df['date'])\n",
        "\n",
        "df['datetime'] = (\n",
        "    df['date'] +\n",
        "    pd.to_timedelta(df['hour'], unit='h')\n",
        ")\n",
        "\n",
        "# Sort Data\n",
        "df = df.sort_values([\n",
        "    'site_name',\n",
        "    'datetime'\n",
        "])\n",
        "\n",
        "# Prepare Prophet Format\n",
        "prophet_df = df.copy()\n",
        "\n",
        "prophet_df = prophet_df.rename(columns={\n",
        "    'datetime': 'ds',\n",
        "    'sum_dl_traffic_volume_gb': 'y'\n",
        "})\n",
        "\n",
        "# Remove timezone information from 'ds' column\n",
        "if prophet_df['ds'].dt.tz is not None:\n",
        "    prophet_df['ds'] = prophet_df['ds'].dt.tz_localize(None)\n",
        "\n",
        "# Train and Validation Split\n",
        "\n",
        "# Training Data\n",
        "# 2nd March -> 4th March\n",
        "train_df = prophet_df[\n",
        "    (prophet_df['date'] >= '2026-03-02') &\n",
        "    (prophet_df['date'] <= '2026-03-04')\n",
        "].copy()\n",
        "\n",
        "# Validation Data\n",
        "# 5th March\n",
        "val_df = prophet_df[\n",
        "    (prophet_df['date'] == '2026-03-05')\n",
        "].copy()\n",
        "\n",
        "# Remove Nulls from Training\n",
        "train_df = train_df.dropna(subset=['y'])\n",
        "\n",
        "# TRrain Model per Site\n",
        "models = {}\n",
        "results = []\n",
        "forecasts = {}\n",
        "\n",
        "site_list = train_df['site_name'].unique()\n",
        "\n",
        "for site in site_list:\n",
        "\n",
        "    # Train Data\n",
        "    site_train = train_df[\n",
        "        train_df['site_name'] == site\n",
        "    ][['ds', 'y']]\n",
        "\n",
        "    # Validation Data\n",
        "    site_val = val_df[\n",
        "        val_df['site_name'] == site\n",
        "    ][['ds', 'y']]\n",
        "\n",
        "    # Skip weak sites\n",
        "    if len(site_train) < 24 or len(site_val) == 0:\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "\n",
        "        # Prophet Model\n",
        "        model = Prophet(\n",
        "            daily_seasonality=True,\n",
        "            weekly_seasonality=False\n",
        "        )\n",
        "\n",
        "        model.fit(site_train)\n",
        "\n",
        "        models[site] = model\n",
        "\n",
        "        # Predict Validation\n",
        "        future = site_val[['ds']]\n",
        "\n",
        "        forecast = model.predict(future)\n",
        "\n",
        "        forecasts[site] = forecast\n",
        "\n",
        "        # Merge Actual + Prediction\n",
        "        merged = pd.merge(\n",
        "            site_val,\n",
        "            forecast[['ds', 'yhat']],\n",
        "            on='ds'\n",
        "        )\n",
        "\n",
        "        merged = merged.dropna()\n",
        "\n",
        "        if len(merged) == 0:\n",
        "            continue\n",
        "\n",
        "        # Metrics\n",
        "        mae = mean_absolute_error(\n",
        "            merged['y'],\n",
        "            merged['yhat']\n",
        "        )\n",
        "\n",
        "        rmse = np.sqrt(\n",
        "            mean_squared_error(\n",
        "                merged['y'],\n",
        "                merged['yhat']\n",
        "            )\n",
        "        )\n",
        "\n",
        "        r2 = r2_score(\n",
        "            merged['y'],\n",
        "            merged['yhat']\n",
        "        )\n",
        "\n",
        "        results.append({\n",
        "            'site_name': site,\n",
        "            'MAE': mae,\n",
        "            'RMSE': rmse,\n",
        "            'R2': r2\n",
        "        })\n",
        "\n",
        "    except Exception as e:\n",
        "\n",
        "        print(f\"Skipping {site}: {e}\")\n",
        "\n",
        "# Results Table\n",
        "results_df = pd.DataFrame(results)\n",
        "\n",
        "print(\"\\n===== PROPHET PERFORMANCE =====\")\n",
        "print(results_df)\n",
        "\n",
        "# Overall Performance\n",
        "print(\"\\n===== OVERALL PERFORMANCE =====\")\n",
        "\n",
        "print(\"Average MAE :\", results_df['MAE'].mean())\n",
        "print(\"Average RMSE:\", results_df['RMSE'].mean())\n",
        "print(\"Average R2  :\", results_df['R2'].mean())\n"
      ]
