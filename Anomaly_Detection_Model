      "source": [
        "# LSTM based Traffic Forecasting\n",
        "# TRraining  : 2nd March -> 4th March\n",
        "# Validation: 5th March\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import LSTM, Dense\n",
        "from tensorflow.keras import backend as K\n",
        "\n",
        "# Create Date time\n",
        "df['date'] = pd.to_datetime(df['date'])\n",
        "\n",
        "df['datetime'] = (\n",
        "    df['date'] +\n",
        "    pd.to_timedelta(df['hour'], unit='h')\n",
        ")\n",
        "\n",
        "# Sort Data\n",
        "df = df.sort_values([\n",
        "    'site_name',\n",
        "    'datetime'\n",
        "])\n",
        "\n",
        "# Train and Validation  Split\n",
        "\n",
        "# Train:\n",
        "# 2nd March -> 4th March\n",
        "train_df = df[\n",
        "    (df['date'] >= '2026-03-02') &\n",
        "    (df['date'] <= '2026-03-04')\n",
        "].copy()\n",
        "\n",
        "# Validation:\n",
        "# 5th March\n",
        "val_df = df[\n",
        "    (df['date'] == '2026-03-05')\n",
        "].copy()\n",
        "\n",
        "# Remove Nulls from Training\n",
        "train_df = train_df.dropna(\n",
        "    subset=['sum_dl_traffic_volume_gb']\n",
        ")\n",
        "\n",
        "# Paramaters\n",
        "LOOKBACK = 24\n",
        "ANOMALY_THRESHOLD = 1\n",
        "\n",
        "# Store Results\n",
        "results = []\n",
        "anomaly_list = []\n",
        "forecasts = {}\n",
        "\n",
        "# LIimit Number of Sites\n",
        "site_list = train_df['site_name'].unique()[:50]\n",
        "\n",
        "# Train Model per Site\n",
        "for site in site_list:\n",
        "\n",
        "    print(f\"Processing Site: {site}\")\n",
        "\n",
        "    # Site Data\n",
        "    site_train = train_df[\n",
        "        train_df['site_name'] == site\n",
        "    ].sort_values('datetime')\n",
        "\n",
        "    site_val = val_df[\n",
        "        val_df['site_name'] == site\n",
        "    ].sort_values('datetime')\n",
        "\n",
        "    # Skip weak sites\n",
        "    if len(site_train) < LOOKBACK + 5:\n",
        "        continue\n",
        "\n",
        "    if len(site_val) == 0:\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "\n",
        "        # Target Series\n",
        "        train_series = (\n",
        "            site_train['sum_dl_traffic_volume_gb']\n",
        "            .values\n",
        "            .reshape(-1, 1)\n",
        "        )\n",
        "\n",
        "        # Scaling\n",
        "        scaler = MinMaxScaler()\n",
        "\n",
        "        train_scaled = scaler.fit_transform(\n",
        "            train_series\n",
        "        )\n",
        "\n",
        "        # Create Sequences\n",
        "        X_train = []\n",
        "        y_train = []\n",
        "\n",
        "        for i in range(LOOKBACK, len(train_scaled)):\n",
        "\n",
        "            X_train.append(\n",
        "                train_scaled[\n",
        "                    i-LOOKBACK:i\n",
        "                ]\n",
        "            )\n",
        "\n",
        "            y_train.append(\n",
        "                train_scaled[i]\n",
        "            )\n",
        "\n",
        "        X_train = np.array(X_train)\n",
        "        y_train = np.array(y_train)\n",
        "\n",
        "        # Build light weight LSTM Model\n",
        "        model = Sequential()\n",
        "\n",
        "        model.add(\n",
        "            LSTM(\n",
        "                16,\n",
        "                input_shape=(LOOKBACK, 1)\n",
        "            )\n",
        "        )\n",
        "\n",
        "        model.add(Dense(1))\n",
        "\n",
        "        model.compile(\n",
        "            optimizer='adam',\n",
        "            loss='mse'\n",
        "        )\n",
        "\n",
        "        # Train Model\n",
        "        model.fit(\n",
        "            X_train,\n",
        "            y_train,\n",
        "            epochs=5,\n",
        "            batch_size=16,\n",
        "            verbose=0\n",
        "        )\n",
        "\n",
        "        # Forecasting\n",
        "        history = train_scaled[-LOOKBACK:]\n",
        "\n",
        "        predictions = []\n",
        "\n",
        "        for i in range(len(site_val)):\n",
        "\n",
        "            X_input = history.reshape(\n",
        "                1,\n",
        "                LOOKBACK,\n",
        "                1\n",
        "            )\n",
        "\n",
        "            y_pred_scaled = model.predict(\n",
        "                X_input,\n",
        "                verbose=0\n",
        "            )\n",
        "\n",
        "            y_pred = scaler.inverse_transform(\n",
        "                y_pred_scaled\n",
        "            )[0][0]\n",
        "\n",
        "            predictions.append(y_pred)\n",
        "\n",
        "            history = np.append(\n",
        "                history[1:],\n",
        "                y_pred_scaled\n",
        "            )\n",
        "\n",
        "        # Store Forecasts\n",
        "        forecast_df = site_val[\n",
        "            ['datetime']\n",
        "        ].copy()\n",
        "\n",
        "        forecast_df['PredictedTraffic'] = (\n",
        "            predictions\n",
        "        )\n",
        "\n",
        "        forecast_df['ActualTraffic'] = (\n",
        "            site_val[\n",
        "                'sum_dl_traffic_volume_gb'\n",
        "            ].values\n",
        "        )\n",
        "\n",
        "        forecasts[site] = forecast_df\n",
        "\n",
        "        # Metrics\n",
        "        merged = forecast_df.dropna()\n",
        "\n",
        "        if len(merged) == 0:\n",
        "            continue\n",
        "\n",
        "        mae = mean_absolute_error(\n",
        "            merged['ActualTraffic'],\n",
        "            merged['PredictedTraffic']\n",
        "        )\n",
        "\n",
        "        rmse = np.sqrt(\n",
        "            mean_squared_error(\n",
        "                merged['ActualTraffic'],\n",
        "                merged['PredictedTraffic']\n",
        "            )\n",
        "        )\n",
        "\n",
        "        r2 = r2_score(\n",
        "            merged['ActualTraffic'],\n",
        "            merged['PredictedTraffic']\n",
        "        )\n",
        "\n",
        "        results.append({\n",
        "            'site_name': site,\n",
        "            'MAE': mae,\n",
        "            'RMSE': rmse,\n",
        "            'R2': r2\n",
        "        })\n",
        "\n",
        "        # Anomaly Detection\n",
        "        merged['is_null_anomaly'] = (\n",
        "            merged['ActualTraffic'].isnull()\n",
        "        )\n",
        "\n",
        "        merged = merged[\n",
        "            merged['PredictedTraffic'] != 0\n",
        "        ]\n",
        "\n",
        "        merged['deviation'] = (\n",
        "            abs(\n",
        "                merged['ActualTraffic']\n",
        "                -\n",
        "                merged['PredictedTraffic']\n",
        "            )\n",
        "            /\n",
        "            merged['PredictedTraffic']\n",
        "        )\n",
        "\n",
        "        merged['is_deviation_anomaly'] = (\n",
        "            merged['deviation']\n",
        "            >\n",
        "            ANOMALY_THRESHOLD\n",
        "        )\n",
        "\n",
        "        anomalies = merged[\n",
        "            (\n",
        "                merged['is_null_anomaly']\n",
        "            )\n",
        "            |\n",
        "            (\n",
        "                merged['is_deviation_anomaly']\n",
        "            )\n",
        "        ].copy()\n",
        "\n",
        "        anomalies['site_name'] = site\n",
        "\n",
        "        anomaly_list.append(anomalies)\n",
        "\n",
        "        # Clear Memory\n",
        "        tf.compat.v1.reset_default_graph()\n",
        "\n",
        "    except Exception as e:\n",
        "\n",
        "        print(f\"Skipping {site}: {e}\")\n",
        "\n",
        "# Results Table\n",
        "results_df = pd.DataFrame(results)\n",
        "\n",
        "print(\"\\n===== LSTM PERFORMANCE =====\")\n",
        "print(results_df)\n",
        "\n",
        "# Overall Performance\n",
        "print(\"\\n===== OVERALL PERFORMANCE =====\")\n",
        "\n",
        "print(\"Average MAE :\", results_df['MAE'].mean())\n",
        "print(\"Average RMSE:\", results_df['RMSE'].mean())\n",
        "print(\"Average R2  :\", results_df['R2'].mean())\n",
        "\n",
        "# Combine Anomalies\n",
        "if len(anomaly_list) > 0:\n",
        "\n",
        "    anomaly_df = pd.concat(anomaly_list)\n",
        "\n",
        "    print(\"\\n===== ANOMALY REPORT =====\")\n",
        "    print(anomaly_df)\n",
        "\n",
        "    anomaly_df.to_csv(\n",
        "        \"lstm_anomaly_report.csv\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    print(\"\\nAnomaly report saved.\")\n",
        "\n",
        "# Visualize Sample Site\n",
        "if len(results_df) > 0:\n",
        "\n",
        "    sample_site = results_df.iloc[0]['site_name']\n",
        "\n",
        "    plot_df = forecasts[sample_site]\n",
        "\n",
        "    plt.figure(figsize=(14,6))\n",
        "\n",
        "    plt.plot(\n",
        "        plot_df['datetime'],\n",
        "        plot_df['ActualTraffic'],\n",
        "        label='Actual'\n",
        "    )\n",
        "\n",
        "    plt.plot(\n",
        "        plot_df['datetime'],\n",
        "        plot_df['PredictedTraffic'],\n",
        "        label='Predicted'\n",
        "    )\n",
        "\n",
        "    plt.title(\n",
        "        f\"LSTM Forecast - {sample_site}\"\n",
        "    )\n",
        "\n",
        "    plt.xlabel(\"Datetime\")\n",
        "\n",
        "    plt.ylabel(\"Traffic Volume (GB)\")\n",
        "\n",
        "    plt.xticks(rotation=45)\n",
        "\n",
        "    plt.legend()\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    plt.show()"
      ]
