      "source": [
        "# Import Libraries\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from xgboost import XGBRegressor\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "# Format Date Time\n",
        "df['date'] = pd.to_datetime(df['date'])\n",
        "\n",
        "df['datetime'] = (\n",
        "    df['date'] +\n",
        "    pd.to_timedelta(df['hour'], unit='h')\n",
        ")\n",
        "\n",
        "# Sort values\n",
        "df = df.sort_values([\n",
        "    'site_name',\n",
        "    'datetime'\n",
        "])\n",
        "\n",
        "# Feature Engineering\n",
        "def create_features(data):\n",
        "\n",
        "    data = data.copy()\n",
        "\n",
        "    # Time Features\n",
        "    data['hour'] = data['datetime'].dt.hour\n",
        "    data['dayofweek'] = data['datetime'].dt.dayofweek\n",
        "\n",
        "    # Lag Features\n",
        "    data['lag1'] = (\n",
        "        data.groupby('site_name')\n",
        "        ['sum_dl_traffic_volume_gb']\n",
        "        .shift(1)\n",
        "    )\n",
        "\n",
        "    data['lag24'] = (\n",
        "        data.groupby('site_name')\n",
        "        ['sum_dl_traffic_volume_gb']\n",
        "        .shift(24)\n",
        "    )\n",
        "\n",
        "    # Rolling Mean\n",
        "    data['rolling_3'] = (\n",
        "        data.groupby('site_name')\n",
        "        ['sum_dl_traffic_volume_gb']\n",
        "        .rolling(3)\n",
        "        .mean()\n",
        "        .reset_index(level=0, drop=True)\n",
        "    )\n",
        "\n",
        "    return data\n",
        "\n",
        "# Apply feature engineering\n",
        "df = create_features(df)\n",
        "\n",
        "# Train and Validation Data Split\n",
        "# TRAIN: 2nd -> 4th March\n",
        "train_df = df[\n",
        "    (df['date'] >= '2026-03-02') &\n",
        "    (df['date'] <= '2026-03-04')\n",
        "].copy()\n",
        "\n",
        "# VALIDATION: 5th March\n",
        "val_df = df[\n",
        "    (df['date'] == '2026-03-05')\n",
        "].copy()\n",
        "\n",
        "# Remove NA generated from lagging\n",
        "train_df = train_df.dropna()\n",
        "val_df = val_df.dropna()\n",
        "\n",
        "\n",
        "# Features and Traget Parameter\n",
        "features = [\n",
        "    'hour',\n",
        "    'dayofweek',\n",
        "    'sum_avg_connected_users',\n",
        "    'sum_avg_dl_user_thp_qci_8_kbps_num',\n",
        "    'sum_avg_dl_user_thp_qci_8_kbps_deno',\n",
        "    'sum_avg_dl_user_thp_qci_9_kbps_num',\n",
        "    'sum_avg_dl_user_thp_qci_9_kbps_deno',\n",
        "    'lag1',\n",
        "    'lag24',\n",
        "    'rolling_3'\n",
        "]\n",
        "\n",
        "target = 'sum_dl_traffic_volume_gb'\n",
        "\n",
        "# Train model per site\n",
        "models = {}\n",
        "results = []\n",
        "\n",
        "site_list = train_df['site_name'].unique()\n",
        "\n",
        "for site in site_list:\n",
        "\n",
        "    # Train data\n",
        "    site_train = train_df[\n",
        "        train_df['site_name'] == site\n",
        "    ]\n",
        "\n",
        "    # Validation data\n",
        "    site_val = val_df[\n",
        "        val_df['site_name'] == site\n",
        "    ]\n",
        "\n",
        "    # Skip weak sites\n",
        "    if len(site_train) < 24 or len(site_val) == 0:\n",
        "        continue\n",
        "\n",
        "    # Training the model\n",
        "    X_train = site_train[features]\n",
        "    y_train = site_train[target]\n",
        "\n",
        "    model = XGBRegressor(\n",
        "        n_estimators=100,\n",
        "        max_depth=4,\n",
        "        learning_rate=0.1,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    model.fit(X_train, y_train)\n",
        "\n",
        "    models[site] = model\n",
        "\n",
        "    # Validation\n",
        "    X_val = site_val[features]\n",
        "    y_val = site_val[target]\n",
        "\n",
        "    y_pred = model.predict(X_val)\n",
        "\n",
        "    # Generate Measuring Parameters\n",
        "    mae = mean_absolute_error(y_val, y_pred)\n",
        "\n",
        "    rmse = np.sqrt(\n",
        "        mean_squared_error(y_val, y_pred)\n",
        "    )\n",
        "\n",
        "    r2 = r2_score(y_val, y_pred)\n",
        "\n",
        "    results.append({\n",
        "        'site_name': site,\n",
        "        'MAE': mae,\n",
        "        'RMSE': rmse,\n",
        "        'R2': r2\n",
        "    })\n",
        "\n",
        "# Create Results Table\n",
        "results_df = pd.DataFrame(results)\n",
        "\n",
