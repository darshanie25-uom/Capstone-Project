        "# Anomaly Detection using Trained ML Model\n",
        "# Validation Data: 5th March\n",
        "# Anomaly Threshold: 100%\n",
        "\n",
        "ANOMALY_THRESHOLD = 1\n",
        "\n",
        "anomaly_list = []\n",
        "\n",
        "for site in models.keys():\n",
        "\n",
        "    # Validation Data\n",
        "    site_val = val_df[\n",
        "        val_df['site_name'] == site\n",
        "    ].copy()\n",
        "\n",
        "    if len(site_val) == 0:\n",
        "        continue\n",
        "\n",
        "    model = models[site]\n",
        "\n",
        "    # Actual Traffic Calculation\n",
        "    site_val['ActualTraffic'] = (\n",
        "        site_val['sum_dl_traffic_volume_gb']\n",
        "    )\n",
        "\n",
        "    # NULL Anomaly Detection\n",
        "    site_val['is_null_anomaly'] = (\n",
        "        site_val['ActualTraffic'].isnull()\n",
        "    )\n",
        "\n",
        "    # Predict non-NULL rows\n",
        "    predict_df = site_val.dropna(subset=features)\n",
        "\n",
        "    if len(predict_df) == 0:\n",
        "        continue\n",
        "\n",
        "    X_val = predict_df[features]\n",
        "\n",
        "    # Prediction\n",
        "    predict_df['PredictedTraffic'] = (\n",
        "        model.predict(X_val)\n",
        "    )\n",
        "\n",
        "    # Avoid Divide by Zero\n",
        "    predict_df = predict_df[\n",
        "        predict_df['PredictedTraffic'] != 0\n",
        "    ]\n",
        "\n",
        "    # Deviation calculation\n",
        "    predict_df['deviation'] = (\n",
        "        abs(\n",
        "            predict_df['ActualTraffic']\n",
        "            -\n",
        "            predict_df['PredictedTraffic']\n",
        "        )\n",
        "        /\n",
        "        predict_df['PredictedTraffic']\n",
        "    )\n",
        "\n",
        "    # Deviation Anomaly iedntification\n",
        "    predict_df['is_deviation_anomaly'] = (\n",
        "        predict_df['deviation'] > ANOMALY_THRESHOLD\n",
        "    )\n",
        "\n",
        "    # FIinal Anomalies Data Set\n",
        "    anomalies = predict_df[\n",
        "        (\n",
        "            predict_df['is_null_anomaly']\n",
        "        )\n",
        "        |\n",
        "        (\n",
        "            predict_df['is_deviation_anomaly']\n",
        "        )\n",
        "    ].copy()\n",
        "\n",
        "    anomaly_list.append(anomalies)\n",
        "\n",
        "# Combine All Anomalies\n",
        "anomaly_df = pd.concat(anomaly_list)\n",
        "\n",
        "# Select Output Columns\n",
        "anomaly_df = anomaly_df[\n",
        "    [\n",
        "        'datetime',\n",
        "        'site_name',\n",
        "        'ActualTraffic',\n",
        "        'PredictedTraffic',\n",
        "        'deviation',\n",
        "        'is_null_anomaly',\n",
        "        'is_deviation_anomaly'\n",
        "    ]\n",
        "]\n",
        "\n",
        "# Diisplay results\n",
        "print(anomaly_df)\n",
        "\n",
        "# Save Report\n",
        "anomaly_df.to_csv(\n",
        "    \"ml_anomaly_report.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\nAnomaly report saved.\")"
