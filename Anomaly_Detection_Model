      "source": [
        "# Neuralprophet Forecasting\n",
        "# Training  : 2nd March -> 4th March\n",
        "# Validation: 5th March\n",
        "\n",
        "!pip uninstall -y torch torchvision torchaudio pytorch-lightning neuralprophet\n",
        "!pip install neuralprophet torchvision torchaudio\n",
        "\n",
        "# Imports\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import gc\n",
        "\n",
        "from neuralprophet import NeuralProphet\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "# Create Date time\n",
        "df['date'] = pd.to_datetime(df['date'])\n",
        "\n",
        "df['datetime'] = (\n",
        "    df['date'] +\n",
        "    pd.to_timedelta(df['hour'], unit='h')\n",
        ")\n",
        "\n",
        "# Sort Data\n",
        "df = df.sort_values([\n",
        "    'site_name',\n",
        "    'datetime'\n",
        "])\n",
        "\n",
        "# Prepare Data\n",
        "neural_df = df.copy()\n",
        "\n",
        "neural_df = neural_df.rename(columns={\n",
        "    'datetime': 'ds',\n",
        "    'sum_dl_traffic_volume_gb': 'y'\n",
        "})\n",
        "\n",
        "# Train/ Validation Split\n",
        "\n",
        "# Train:\n",
        "# 2nd March -> 4th March\n",
        "train_df = neural_df[\n",
        "    (neural_df['date'] >= '2026-03-02') &\n",
        "    (neural_df['date'] <= '2026-03-04')\n",
        "].copy()\n",
        "\n",
        "# Validation:\n",
        "# 5th March\n",
        "val_df = neural_df[\n",
        "    (neural_df['date'] == '2026-03-05')\n",
        "].copy()\n",
        "\n",
        "# Remove Nulls from Training\n",
        "train_df = train_df.dropna(subset=['y'])\n",
        "\n",
        "train_df['y'] = train_df['y'].astype('float32')\n",
        "val_df['y'] = val_df['y'].astype('float32')\n",
        "\n",
        "# Paramater Thresholds\n",
        "ANOMALY_THRESHOLD = 1\n",
        "\n",
        "# Store Results\n",
        "results = []\n",
        "anomaly_list = []\n",
        "forecasts = {}\n",
        "\n",
        "# Limit Number of Sites\n",
        "site_list = train_df['site_name'].unique()[:50]\n",
        "\n",
        "# Train Model per Site\n",
        "for site in site_list:\n",
        "\n",
        "    print(f\"Processing Site: {site}\")\n",
        "\n",
        "    # Site Train Data\n",
        "    site_train = train_df[\n",
        "        train_df['site_name'] == site\n",
        "    ][['ds', 'y']].copy()\n",
        "\n",
        "    # Site Validation Data\n",
        "    site_val = val_df[\n",
        "        val_df['site_name'] == site\n",
        "    ][['ds', 'y']].copy()\n",
        "\n",
        "    # Skip weak sites\n",
        "    if len(site_train) < 24:\n",
        "        continue\n",
        "\n",
        "    if len(site_val) == 0:\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "\n",
        "        # Lightweight Neuralprophet\n",
        "        model = NeuralProphet(\n",
        "\n",
        "            # Smaller lag window\n",
        "            n_lags=12,\n",
        "\n",
        "            # Forecast 1 step\n",
        "            n_forecasts=1,\n",
        "\n",
        "            # Seasonality\n",
        "            daily_seasonality=True,\n",
        "            weekly_seasonality=False,\n",
        "\n",
        "            # Reduce complexity\n",
        "            epochs=5,\n",
        "\n",
        "            # Smaller learning rate\n",
        "            learning_rate=0.01,\n",
        "\n",
        "            # Disable unnecessary features\n",
        "            yearly_seasonality=False\n",
        "        )\n",
        "\n",
        "        # Train Model\n",
        "        model.fit(\n",
        "            site_train,\n",
        "            freq='H',\n",
        "            progress='off'\n",
        "        )\n",
        "\n",
        "        # Create Future Data Frame\n",
        "        future = model.make_future_dataframe(\n",
        "            site_train,\n",
        "            periods=len(site_val),\n",
        "            n_historic_predictions=False\n",
        "        )\n",
        "\n",
        "        # Forecast\n",
        "        forecast = model.predict(future)\n",
        "\n",
        "        forecast = forecast.tail(len(site_val))\n",
        "\n",
        "        # STtore only required columns\n",
        "        forecast_small = forecast[\n",
        "            ['ds', 'yhat1']\n",
        "        ].copy()\n",
        "\n",
        "        forecasts[site] = forecast_small\n",
        "\n",
        "        # Merge Actual + Predicted\n",
        "        merged = pd.merge(\n",
        "            site_val,\n",
        "            forecast_small,\n",
        "            on='ds'\n",
        "        )\n",
        "\n",
        "        merged = merged.dropna()\n",
        "\n",
        "        if len(merged) == 0:\n",
        "            continue\n",
        "\n",
        "        # Metrics\n",
        "        mae = mean_absolute_error(\n",
        "            merged['y'],\n",
        "            merged['yhat1']\n",
        "        )\n",
        "\n",
        "        rmse = np.sqrt(\n",
        "            mean_squared_error(\n",
        "                merged['y'],\n",
        "                merged['yhat1']\n",
        "            )\n",
        "        )\n",
        "\n",
        "        r2 = r2_score(\n",
        "            merged['y'],\n",
        "            merged['yhat1']\n",
        "        )\n",
        "\n",
        "        results.append({\n",
        "            'site_name': site,\n",
        "            'MAE': mae,\n",
        "            'RMSE': rmse,\n",
        "            'R2': r2\n",
        "        })\n",
        "\n",
        "        # Anomaly Detection\n",
        "        merged['ActualTraffic'] = merged['y']\n",
        "\n",
        "        merged['PredictedTraffic'] = merged['yhat1']\n",
        "\n",
        "        merged['deviation'] = (\n",
        "            abs(\n",
        "                merged['ActualTraffic']\n",
        "                -\n",
        "                merged['PredictedTraffic']\n",
        "            )\n",
        "            /\n",
        "            merged['PredictedTraffic']\n",
        "        )\n",
        "\n",
        "        merged['is_null_anomaly'] = (\n",
        "            merged['ActualTraffic'].isnull()\n",
        "        )\n",
        "\n",
        "        merged['is_deviation_anomaly'] = (\n",
        "            merged['deviation']\n",
        "            >\n",
        "            ANOMALY_THRESHOLD\n",
        "        )\n",
        "\n",
        "        anomalies = merged[\n",
        "            (\n",
        "                merged['is_null_anomaly']\n",
        "            )\n",
        "            |\n",
        "            (\n",
        "                merged['is_deviation_anomaly']\n",
        "            )\n",
        "        ].copy()\n",
        "\n",
        "        anomalies['site_name'] = site\n",
        "\n",
        "        anomaly_list.append(anomalies)\n",
        "\n",
        "        # Memory Cleanup\n",
        "        del model\n",
        "        del forecast\n",
        "        del future\n",
        "        del merged\n",
        "\n",
        "        gc.collect()\n",
        "\n",
        "    except Exception as e:\n",
        "\n",
        "        print(f\"Skipping {site}: {e}\")\n",
        "\n",
        "# Results Table\n",
        "results_df = pd.DataFrame(results)\n",
        "\n",
        "print(\"\\n===== NEURALPROPHET PERFORMANCE =====\")\n",
        "print(results_df)\n",
        "\n",
        "# Overall Performance\n",
        "print(\"\\n===== OVERALL PERFORMANCE =====\")\n",
        "\n",
        "print(\"Average MAE :\", results_df['MAE'].mean())\n",
        "print(\"Average RMSE:\", results_df['RMSE'].mean())\n",
        "print(\"Average R2  :\", results_df['R2'].mean())\n",
        "\n",
        "# Combine Anomalies\n",
        "if len(anomaly_list) > 0:\n",
        "\n",
        "    anomaly_df = pd.concat(anomaly_list)\n",
        "\n",
        "    anomaly_df = anomaly_df[\n",
        "        [\n",
        "            'ds',\n",
        "            'site_name',\n",
        "            'ActualTraffic',\n",
        "            'PredictedTraffic',\n",
        "            'deviation',\n",
        "            'is_null_anomaly',\n",
        "            'is_deviation_anomaly'\n",
        "        ]\n",
        "    ]\n",
        "\n",
        "    anomaly_df = anomaly_df.rename(columns={\n",
        "        'ds': 'datetime'\n",
        "    })\n",
        "\n",
        "    print(\"\\n===== ANOMALY REPORT =====\")\n",
        "    print(anomaly_df)\n",
        "\n",
        "    anomaly_df.to_csv(\n",
        "        \"neuralprophet_anomaly_report.csv\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    print(\"\\nAnomaly report saved.\")\n",
        "\n",
        "# Visualize Sample Site\n",
        "if len(results_df) > 0:\n",
        "\n",
        "    sample_site = results_df.iloc[0]['site_name']\n",
        "\n",
        "    forecast = forecasts[sample_site]\n",
        "\n",
        "    actual = val_df[\n",
        "        val_df['site_name'] == sample_site\n",
        "    ]\n",
        "\n",
        "    merged_plot = pd.merge(\n",
        "        actual,\n",
        "        forecast,\n",
        "        on='ds'\n",
        "    )\n",
        "\n",
        "    plt.figure(figsize=(14,6))\n",
        "\n",
        "    plt.plot(\n",
        "        merged_plot['ds'],\n",
        "        merged_plot['y'],\n",
        "        label='Actual'\n",
        "    )\n",
        "\n",
        "    plt.plot(\n",
        "        merged_plot['ds'],\n",
        "        merged_plot['yhat1'],\n",
        "        label='Predicted'\n",
        "    )\n",
        "\n",
        "    plt.title(\n",
        "        f\"NeuralProphet Forecast - {sample_site}\"\n",
        "    )\n",
        "\n",
        "    plt.xlabel(\"Datetime\")\n",
        "\n",
        "    plt.ylabel(\"Traffic Volume (GB)\")\n",
        "\n",
        "    plt.xticks(rotation=45)\n",
        "\n",
        "    plt.legend()\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    plt.show()"
      ]
    },
